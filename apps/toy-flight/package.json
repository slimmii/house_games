{
  "name": "@huis/toy-flight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Little Rotors: the multiplayer drone game in the house. Its server also serves the tower defense build at /defense/.",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/add-defense.mjs && node scripts/precompress-client.mjs && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "test": "node --import tsx --import @huis/house/node/setupCollision --test tests/*.test.ts",
    "test:browser": "node --import tsx tests/browser.smoke.ts",
    "test:textures": "node tests/texture-memory.smoke.mjs",
    "test:lighting:browser": "node tests/lighting.browser.mjs",
    "test:perf": "node tests/game-perf.browser.mjs",
    "benchmark": "node --import tsx tests/performance.ts",
    "bench:lighting": "node tests/lighting.browser.mjs",
    "bench:compare": "node tests/lighting-compare.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.52",
    "@colyseus/sdk": "^0.17.0",
    "@colyseus/ws-transport": "^0.17.0",
    "@huis/house": "0.1.0",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "meshoptimizer": "^1.3.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.15"
  }
}
